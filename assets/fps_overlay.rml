<rml>
<head>
    <link type="text/rcss" href="rml.rcss"/>
    <link type="text/rcss" href="recomp.rcss"/>
    <style>
        body { width: 100%; height: 100%; }
        #fps_box { position: absolute; top: 8dp; right: 8dp; padding: 2dp 8dp; background-color: rgba(0,0,0,0.6); border-radius: 6dp; }
        #fps_text { color: rgb(242,242,242); font-size: 20dp; }
    </style>
</head>
<body>
    <div id="fps_box"><span id="fps_text"></span></div>
</body>
</rml>