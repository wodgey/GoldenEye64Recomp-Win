<rml>
<head>
	<link type="text/rcss" href="rml.rcss"/>
	<link type="text/rcss" href="recomp.rcss"/>
	<title>Inventory</title>
	<style>
		body
		{
			width: 100%;
			height: 100%;
		}

		/* Hide the window icon. */
		div#title_bar div#icon
		{
			display: none;
		}
		.flex-grid {
			display: flex;
		}
		.col {
			flex: 1;
    		text-align: center;
		}
	
                /* Mods tab: Conker frontend theme values (alpha is 0-1 in this RmlUi build) */
                .mods { display: flex; flex-direction: column; width: 100%; height: 100%; color: rgb(242,242,242); }
                .mods__main { display: flex; flex-direction: row; flex: 1 1 0dp; width: 100%; }
                .mods__list { width: 32%; height: 100%; overflow-y: auto; }
                .mods__details { flex: 1 1 auto; height: 100%; display: flex; flex-direction: column; background-color: rgba(182,194,221,0.10); }
                .mods__empty { padding: 20dp; color: rgb(204,204,204); }

                .mod-entry { display: flex; flex-direction: row; align-items: center; width: 100%; height: 68dp; padding: 6dp; border-left-width: 3dp; border-left-color: rgba(255,255,255,0.05); background-color: rgba(255,255,255,0.05); color: rgb(242,242,242); text-align: left; }
                .mod-entry:hover { border-left-color: rgba(255,255,255,0.30); }
                .mod-entry.mod-off { opacity: 0.5; }
                .mod-entry.mod-selected { border-left-color: rgba(255,255,255,0.60); background-color: rgba(255,255,255,0.20); opacity: 1; }
                .mod-entry:focus { border-left-width: 6dp; border-left-color: rgb(247,158,8); background-color: rgba(255,255,255,0.20); opacity: 1; }
                .mod-entry__thumb { width: 56dp; height: 56dp; flex: 0 0 56dp; background-color: rgba(182,194,221,0.10); }
                .mod-entry__body { flex: 1 1 auto; margin-left: 12dp; overflow: hidden; }
                .mod-entry__name { font-weight: bold; color: rgb(242,242,242); }
                .mod-entry__desc { margin-top: 2dp; font-size: 14dp; color: rgb(204,204,204); }
                .mod-entry__state { flex: 0 0 auto; min-width: 40dp; margin-left: 8dp; padding: 2dp 6dp; font-size: 14dp; text-align: center; border-width: 1dp; border-color: rgba(255,255,255,0.60); color: rgb(242,242,242); }
                .mod-entry__state.mod-on { border-color: rgb(247,158,8); background-color: rgb(247,158,8); color: rgb(2,7,18); font-weight: bold; }

                .mods__header { display: flex; flex-direction: row; align-items: center; padding: 14dp; background-color: rgba(0,0,0,0.35); border-bottom-width: 1dp; border-bottom-color: rgba(255,255,255,0.10); }
                .mods__preview { width: 56dp; height: 56dp; flex: 0 0 56dp; background-color: rgba(182,194,221,0.10); }
                .mods__headtext { margin-left: 14dp; }
                .mods__title { font-size: 24dp; font-weight: bold; color: rgb(242,242,242); }
                .mods__body { flex: 1 1 auto; overflow-y: auto; padding: 14dp; text-align: left; color: rgb(242,242,242); }
                .mods__authors { margin-bottom: 12dp; font-weight: bold; color: rgb(242,242,242); }

                .mods__footer { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 12dp 14dp; background-color: rgba(0,0,0,0.35); border-top-width: 1dp; border-top-color: rgba(255,255,255,0.10); }
                .mods__togglewrap { display: flex; flex-direction: row; align-items: center; }
                .mods__status { margin-left: 12dp; font-weight: bold; color: rgb(242,242,242); }
                .mods__hint { font-size: 14dp; color: rgb(204,204,204); }

                .mods-toggle { display: block; width: 64dp; height: 36dp; box-sizing: border-box; padding: 0dp; border-width: 2dp; border-color: rgb(128,128,128); border-radius: 18dp; background-color: rgba(255,255,255,0.05); }
                .mods-toggle__knob { width: 24dp; height: 24dp; margin-top: 4dp; margin-left: 4dp; border-radius: 12dp; background-color: rgb(204,204,204); }
                .mods-toggle.mods-toggle-on { border-color: rgb(247,158,8); background-color: rgba(247,158,8,0.30); }
                .mods-toggle.mods-toggle-on .mods-toggle__knob { margin-left: 32dp; background-color: rgb(247,158,8); }
                .mods-toggle:focus { border-width: 4dp; border-color: rgb(247,158,8); }

                .mods__bar { display: flex; flex-direction: row; align-items: center; justify-content: flex-end; padding: 10dp 14dp; background-color: rgba(0,0,0,0.35); border-top-width: 1dp; border-top-color: rgba(255,255,255,0.10); }
                .mods__button { padding: 10dp 22dp; margin-left: 10dp; border-width: 1dp; border-color: rgb(247,158,8); border-radius: 12dp; background-color: rgba(247,158,8,0.05); color: rgb(242,242,242); }
                .mods__button:hover { background-color: rgba(247,158,8,0.20); }
                .mods__button:focus { border-width: 4dp; background-color: rgba(247,158,8,0.20); }
                .mod-entry, .mods-toggle, .mods__button { tab-index: auto; focus: auto; }
                .mod-entry { nav-up: auto; nav-down: auto; nav-left: auto; nav-right: #mods_toggle_button; }
                #mods_toggle_button { nav-up: auto; nav-down: #mods_refresh_button; nav-left: auto; nav-right: auto; }
                #mods_refresh_button { nav-up: #mods_toggle_button; nav-down: auto; nav-left: auto; nav-right: #mods_folder_button; }
                #mods_folder_button { nav-up: #mods_toggle_button; nav-down: auto; nav-left: #mods_refresh_button; nav-right: auto; }
        </style>
	<link type="text/template" href="config_menu/general.rml" />
	<link type="text/template" href="config_menu/controls.rml" />
	<link type="text/template" href="config_menu/graphics.rml" />
	<link type="text/template" href="config_menu/sound.rml" />
	<link type="text/template" href="config_menu/debug.rml" />
        <link type="text/template" href="config_menu/mods.rml" />
        <link type="text/template" href="config_menu/qol.rml" />
	<link type="text/template" href="components/prompt.rml" />
</head>
<body class="window">
	<!-- <handle move_target="#document"> -->
		<div id="window" class="rmlui-window rmlui-window--hidden" style="display:flex; flex-flow: column; background-color:rgba(0,0,0,0)" onkeydown="config_keydown">
			<div class="centered-page" onclick="close_config_menu_backdrop">
				<div class="centered-page__modal">
					<tabset class="tabs" id="config_tabset">
						<tab class="tab" autofocus id="tab_general">
							<div>General</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="general_model">
							<template src="config-menu__general" />
						</panel>
						<tab class="tab" id="tab_controls">
							<div>Controls</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="controls_model">
							<template src="config-menu__controls" />
						</panel>
						<tab class="tab" id="tab_graphics">
							<div>Graphics</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="graphics_model">
							<template src="config-menu__graphics" />
						</panel>
						<tab class="tab" id="tab_sound">
							<div>Sound</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="sound_options_model">
							<template src="config-menu__sound" />
						</panel>
						<tab class="tab" data-model="debug_model" data-if="debug_enabled" id="tab_debug">
							<div>Debug</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="debug_model">
							<template src="config-menu__debug" />
						</panel>
					<tab class="tab" id="tab_mods">
                                                        <div>Mods</div>
                                                        <div class="tab__indicator"></div>
                                                </tab>
                                                <panel class="config" data-model="mods_model">
                                                        <template src="config-menu__mods" />
                                                </panel>
                                        <tab class="tab" id="tab_dual_stick">
                                                <div>QOL Settings</div>
                                                <div class="tab__indicator"></div>
                                        </tab>
                                        <panel class="config" data-model="general_model">
                                                <template src="config-menu__qol" />
                                        </panel>
                                        </tabset>
					<div class="config__icon-buttons">
						<button
							class="icon-button"
							onclick="open_quit_game_prompt"
							id="config__quit-game-button"
						>
							<svg src="icons/Quit.svg" />
						</button>
						<button
							class="icon-button"
							onclick="close_config_menu"
							id="config__close-menu-button"
						>
							<svg src="icons/X.svg" />
						</button>
					</div>
				</div>
				<div
					class="centered-page__controls"
					data-model="nav_help_model"
				>
					<label>
						<span>Navigate</span>
						<span class="prompt-font-sm">{{nav_help__navigate}}</span>
					</label>
					<label>
						<span>Accept</span>
						<span class="prompt-font-sm">{{nav_help__accept}}</span>
					</label>
					<label>
						<span>Exit</span>
						<span class="prompt-font-sm">{{nav_help__exit}}</span>
					</label>
					<!-- <label><span style="font-family:promptfont;">&#x21F3;</span> Navigate</label>
					<label><span style="font-family:promptfont;">&#x21A7;</span> Accept</label> -->
				</div>
			</div>
			<div
				id="prompt-root"
				data-model="prompt_model"
				data-if="prompt__open"
				data-alias-promptOpen="prompt__open"
				data-alias-promptHeader="prompt__header"
				data-alias-promptContent="prompt__content"
				data-alias-promptConfirmLabel="prompt__confirmLabel"
				data-alias-promptCancelLabel="prompt__cancelLabel"
				data-event-click="prompt__on_click"
			>
				<template src="prompt"/>
			</div>
		</div>
	<!-- </handle> -->
	<!-- <handle size_target="#document" style="position: absolute; width: 16dp; height: 16dp; bottom: 0px; right: 0px; cursor: resize;"></handle> -->
</body>
</rml>
